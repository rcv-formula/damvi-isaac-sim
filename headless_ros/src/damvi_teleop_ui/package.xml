<?xml version="1.0"?>
<package format="3">
  <name>damvi_teleop_ui</name>
  <version>0.1.0</version>
  <description>Keyboard mode selector and command monitor for damvi simulation</description>
  <maintainer email="maintainer@example.com">damvi simulator developers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
