# Five requested displays only. Marker colour is supplied by the planner.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: []
      Splitter Ratio: 0.55
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Marker
      Name: localpath_vis
      Enabled: true
      Value: true
      Namespaces:
        corrected_path: true
      Topic:
        Value: /localpath_vis
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Odometry
      Name: odom - PF estimate - blue
      Enabled: true
      Value: true
      Keep: 100
      Position Tolerance: 0.08
      Angle Tolerance: 0.1
      Covariance:
        Value: false
      Shape:
        Value: Arrow
        Alpha: 1
        Color: 45; 110; 255
        Shaft Length: 0.3
        Shaft Radius: 0.025
        Head Length: 0.12
        Head Radius: 0.07
      Topic:
        Value: /odom
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Odometry
      Name: odom gt - green
      Enabled: true
      Value: true
      Keep: 100
      Position Tolerance: 0.08
      Angle Tolerance: 0.1
      Covariance:
        Value: false
      Shape:
        Value: Arrow
        Alpha: 1
        Color: 20; 210; 70
        Shaft Length: 0.26
        Shaft Radius: 0.018
        Head Length: 0.1
        Head Radius: 0.05
      Topic:
        Value: /odom_gt
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: map - 0821
      Enabled: true
      Value: true
      Alpha: 1
      Color Scheme: map
      Draw Behind: true
      Use Timestamp: false
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/LaserScan
      Name: laserscan - red
      Enabled: true
      Value: true
      Alpha: 1
      Color: 255; 45; 45
      Color Transformer: FlatColor
      Position Transformer: XYZ
      Size (Pixels): 3
      Size (m): 0.025
      Style: Points
      Decay Time: 0
      Use Fixed Frame: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Filter size: 20
  Enabled: true
  Value: true
  Name: root
  Global Options:
    Fixed Frame: map
    Background Color: 35; 35; 40
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Value: /initialpose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/XYOrbit
      Name: Current View
      Distance: 25
      Pitch: 1.570696
      Yaw: 4.712389
      Focal Point: {X: 3.324, Y: -0.987, Z: 0}
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
      Value: XYOrbit (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Width: 1400
  Height: 950
  X: 20
  Y: 20
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 000000ff00000000fd000000010000000000000140000003b6fc0200000001fb000000100044006900730070006c0061007900730100000000000003b60000001700ffffff00000432000003b600000004000000040000000800000008fc00000000
